{
    "name": "daniel-km/omeka-s-module-asset-multi",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Attach multiple assets to resources, for example to display an horizontal banner in home page, a skyscraper in another page and a square in lists.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "asset",
        "theme building"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-AssetMulti",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-AssetMulti/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "autoload": {
        "psr-4": {
            "AssetMulti\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AssetMultiTest\\": "tests/AssetMultiTest/"
        }
    },
    "extra": {
        "installer-name": "AssetMulti"
    }
}
