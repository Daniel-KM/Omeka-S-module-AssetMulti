#: data/scripts/upgrade.php:39 Module.php:71
#, php-format
msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Le module %1$s doit être mis à niveau à la version %2$s ou supérieure."

#: Module.php:97
msgid "To get multiple assets for a resource:"
msgstr "Pour disposer de plusieurs vignettes pour une ressource :"

#: Module.php:99
msgid "First, define wanted asset type names in {link}main settings{link_end}."
msgstr ""
"D’abord, définir les noms des types de vignettes souhaités dans les {link}"
"paramètres généraux{link_end}."

#: Module.php:106
msgid ""
"Second, add new assets to resources in the tab \"advanced\" of the {link}"
"resource form{link_end}."
msgstr ""
"Ensuite, ajouter de nouveaux fichiers aux ressources dans l’onglet "
"\"avancé\" du {link}formulaire de ressource{link_end}."

#: Module.php:113
msgid "Third, adapt the site theme to use new resource assets."
msgstr "Enfin, adapter le thème du site pour utiliser les nouvelles vignettes."

#: Module.php:224
msgid ""
"Some complementary assets were removed because the type is missing or "
"duplicated."
msgstr ""
"Certaines vignettes complémentaires ont été supprimées parce que le type est "
"manquant ou dupliqué."

#: Module.php:232
msgid ""
"Some complementary assets were removed because the types {types} are not in "
"the list of allowed types."
msgstr ""
"Certaines vignettes complémentaires ont été supprimées car les types {types} "
"ne figurent pas dans la liste des types autorisés."

#: Module.php:283
msgid ""
"Some complementary assets were not attached. Check data or ask an "
"administrator. {msg}"
msgstr ""
"Certaines vignettes complémentaires n’ont pas été attachées. Vérifiez les "
"données ou demandez à un administrateur. {msg}"

#: Module.php:287
msgid "[Asset Multi] Some complementary assets were not attached: {msg}"
msgstr ""
"[Asset Multi] Certaines vignettes complémentaires n’ont pas été attachées : "
"{msg}"

#: Module.php:415
msgid "Complementary assets"
msgstr "Vignettes complémentaires"

#: src/Form/SettingsFieldset.php:10
msgid "Resource assets"
msgstr "Vignettes des ressources"

#: src/Form/SettingsFieldset.php:22
msgid "Types and labels to attach multiple assets by resource"
msgstr "Types et libellés des vignettes attachées aux ressources"

#: src/Api/Adapter/ResourceAssetAdapter.php:104
msgid "An asset for resource must have a resource."
msgstr "Une vignette pour une ressource doit avoir une ressource."

#: src/Api/Adapter/ResourceAssetAdapter.php:107
msgid "An asset for resource must have an asset."
msgstr "Une vignette pour une ressource doit avoir une vignette."

#: src/Api/Adapter/ResourceAssetAdapter.php:111
msgid "An asset for resource must have a type."
msgstr "Une vignette pour une ressource doit avoir un type."

#: src/Api/Adapter/ResourceAssetAdapter.php:173
#: src/Api/Adapter/ResourceAssetAdapter.php:176
msgid "The resource cannot be empty."
msgstr "La ressource ne peut pas être vide."

#: src/Api/Adapter/ResourceAssetAdapter.php:180
msgid "The type cannot be empty."
msgstr "Le type ne peut pas être vide."

#: src/Api/Adapter/ResourceAssetAdapter.php:188
msgid ""
"The type \"{type}\" is not unique for the pair resource {resource_id} and "
"asset {asset_id}."
msgstr ""
"Le type \"{type}\" n’est pas unique pour la paire ressource {resource_id} et "
"vignette {asset_id}."

